        -command "import maya.cmds as cmds\n\n#0                \naov = cmds.createNode(\"aiAOV\", name=\"aiAOV_Z\")\ncmds.setAttr(aov + \".name\", \"Z\", type=\"string\")\n\n\ncmds.connectAttr(aov + \".message\",\n                 \"defaultArnoldRenderOptions.aovList\",\n                 nextAvailable=True)\n\n#1\naov = cmds.createNode(\"aiAOV\", name=\"_aov_cryptomatte\")\ncmds.setAttr(aov + \".name\", \"crypto_asset\", type=\"string\")\n\ncmds.connectAttr(aov + \".message\",\n                 \"defaultArnoldRenderOptions.aovList\",\n                 nextAvailable=True)" 
