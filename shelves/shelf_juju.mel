global proc shelf_juju () {
    global string $gBuffStr;
    global string $gBuffStr0;
    global string $gBuffStr1;


    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "save vignette" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "save_vignette" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "C:/Users/Julie/Documents/maya/2024/prefs/icons/save_vignette.svg" 
        -image1 "C:/Users/Julie/Documents/maya/2024/prefs/icons/save_vignette.svg" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "fo_onCapturePlayblastbuttonClick SaveAs;" 
        -sourceType "mel" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "import vdb" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "import vdb" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "C:/Users/Julie/Documents/maya/2024/prefs/icons/import_vdb.svg" 
        -image1 "C:/Users/Julie/Documents/maya/2024/prefs/icons/import_vdb.svg" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "cmdArnoldVolume;\n" 
        -sourceType "mel" 
        -commandRepeatable 1
        -flat 1
    ;
    separator
        -enable 1
        -width 34
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -style "shelf" 
        -horizontal 0
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "preview Render" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "preview_render" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "C:/Users/Julie/Documents/maya/2024/prefs/icons/preview.svg" 
        -image1 "C:/Users/Julie/Documents/maya/2024/prefs/icons/preview.svg" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "setAttr \"defaultArnoldDriver.mergeAOVs\" 1;\n\nsetAttr \"defaultArnoldRenderOptions.AASamples\" 2;\nsetAttr \"defaultArnoldRenderOptions.GIDiffuseSamples\" 1;\nsetAttr \"defaultArnoldRenderOptions.GISpecularSamples\" 1;\nsetAttr \"defaultArnoldRenderOptions.GITransmissionSamples\" 1;\nsetAttr \"defaultArnoldRenderOptions.GISssSamples\" 0;\n\nsetAttr \"defaultArnoldRenderOptions.GIDiffuseDepth\" 1;\nsetAttr \"defaultArnoldRenderOptions.GISpecularDepth\" 1;\nsetAttr \"defaultArnoldRenderOptions.GITransmissionDepth\" 1;print(\"User defined macro\");" 
        -sourceType "mel" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "final render" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "final_render" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "C:/Users/Julie/Documents/maya/2024/prefs/icons/final_render.svg" 
        -image1 "C:/Users/Julie/Documents/maya/2024/prefs/icons/final_render.svg" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "setAttr \"defaultArnoldDriver.mergeAOVs\" 1;\n\nsetAttr \"defaultArnoldRenderOptions.AASamples\" 4;             //AA\nsetAttr \"defaultArnoldRenderOptions.GIDiffuseSamples\" 2;     \nsetAttr \"defaultArnoldRenderOptions.GISpecularSamples\" 2;\nsetAttr \"defaultArnoldRenderOptions.GITransmissionSamples\" 1;\nsetAttr \"defaultArnoldRenderOptions.GISssSamples\" 0; \nsetAttr \"defaultArnoldRenderOptions.GIVolumeSamples\" 2;\n\n\nsetAttr \"defaultArnoldRenderOptions.GIDiffuseDepth\" 2;\nsetAttr \"defaultArnoldRenderOptions.GISpecularDepth\" 1;\nsetAttr \"defaultArnoldRenderOptions.GITransmissionDepth\" 1;" 
        -sourceType "mel" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "User Script" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "AOV" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "C:/Users/Julie/Documents/maya/2024/prefs/icons/aov.svg" 
        -image1 "C:/Users/Julie/Documents/maya/2024/prefs/icons/aov.svg" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\n\n#0                \naov = cmds.createNode(\"aiAOV\", name=\"aiAOV_Z\")\ncmds.setAttr(aov + \".name\", \"Z\", type=\"string\")\n\n\ncmds.connectAttr(aov + \".message\",\n                 \"defaultArnoldRenderOptions.aovList\",\n                 nextAvailable=True)\n\n\naov = cmds.createNode(\"aiAOV\", name=\"aiAOV_N\")\ncmds.setAttr(aov + \".name\", \"N\", type=\"string\")\n\n\ncmds.connectAttr(aov + \".message\",\n                 \"defaultArnoldRenderOptions.aovList\",\n                 nextAvailable=True)\n\"\"\"\naov = cmds.createNode(\"aiAOV\", name=\"aiAOV_albedo\")\ncmds.setAttr(aov + \".name\", \"albedo\", type=\"string\")\n\n\ncmds.connectAttr(aov + \".message\",\n                 \"defaultArnoldRenderOptions.aovList\",\n                 nextAvailable=True)\n\"\"\"\n\n### CRYPTO ###\n#1\naov = cmds.createNode(\"aiAOV\", name=\"_aov_cryptomatte\")\ncmds.setAttr(aov + \".name\", \"crypto_asset\", type=\"string\")\n\ncmds.connectAttr(aov + \".message\",\n                 \"defaultArnoldRenderOptions.aovList\",\n                 nextAvailable=True)\n\n#2\naov = cmds.createNode(\"aiAOV\", name=\"aiAOV_crypto_material\")\ncmds.setAttr(aov + \".name\", \"crypto_material\", type=\"string\")\n\ncmds.connectAttr(aov + \".message\",\n                 \"defaultArnoldRenderOptions.aovList\",\n                 nextAvailable=True)\n\naov = cmds.createNode(\"aiAOV\", name=\"_aov_cryptomatte2\")\ncmds.setAttr(aov + \".name\", \"crypto_object\", type=\"string\")\n\ncmds.connectAttr(aov + \".message\",\n                 \"defaultArnoldRenderOptions.aovList\",\n                 nextAvailable=True)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "create_ao_to_aov" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "create_ao" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "commandButton.png" 
        -image1 "commandButton.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\nimport mtoa.aovs as aovs\n\n# Make sure Arnold is loaded\nif not cmds.pluginInfo('mtoa', q=True, loaded=True):\n    cmds.loadPlugin('mtoa')\n\n# 1. Create the AO shader (named so it's not left to chance)\nao_shader = cmds.shadingNode('aiAmbientOcclusion', asShader=True, name='aiAO_shader')\n\n# 2. Create the AOV (AO is a color pass, so 'rgb' is enough)\naov = aovs.AOVInterface().addAOV('AO', aovType='rgb')\n\n# 3. Plug the shader into the AOV's default value\ncmds.connectAttr(ao_shader + '.outColor', aov.node + '.defaultValue', force=True)" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;

} 
